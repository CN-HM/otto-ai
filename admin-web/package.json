    "angular-eslint": "18.4.3",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "~5.5.4",
    "typescript-eslint": "8.16.0"
