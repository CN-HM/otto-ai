{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "admin-api",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/admin-api/bin/Debug/net10.0/AiAdmin.dll",
      "args": [],
      "cwd": "${workspaceFolder}/admin-api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:8002",
        "Cache__UseInMemory": "false",
        "IoTRuntime__Enabled": "true",
        "IoTRuntime__EnableMqtt": "true",
        "IoTRuntime__EnableUdp": "true",
        "IoTRuntime__NodeId": "admin-api-dev",
        "IoTRuntime__MqttPort": "1883",
        "IoTRuntime__UdpPort": "8884",
        "IoTRuntime__PublicIp": "192.168.50.165",
        "IoTRuntime__PythonWsUrls__0": "ws://localhost:8000/v1/"
      },
      "preLaunchTask": "build-admin-api",
      "console": "integratedTerminal"
    },
    {
      "name": "admin-web",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "admin-web-serve",
      "url": "http://localhost:4300",
      "webRoot": "${workspaceFolder}/admin-web/src"
    },
    {
      "name": "ai-admin-app",
      "type": "dart",
      "request": "launch",
      "preLaunchTask": "flutter-pub-get-ai-admin-app",
      "cwd": "${workspaceFolder}/apps/ai_admin_app",
      "program": "${workspaceFolder}/apps/ai_admin_app/lib/main.dart",
      "toolArgs": [
        "--dart-define",
        "API_BASE_URL=http://192.168.50.165:8002"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Dev",
      "configurations": [
        "admin-api",
        "admin-web",
        "ai-admin-app"
      ],
      "stopAll": true
    }
  ]
}